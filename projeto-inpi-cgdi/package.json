{
  "name": "projeto-inpi-cgdi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "generate:components": "node ferramentas/scripts/gerar-bundle-componentes.mjs",
    "secure:prototypes": "node ferramentas/scripts/aplicar-seguranca-prototipos.mjs",
    "disable:unavailable": "node ferramentas/scripts/desabilitar-links-indisponiveis.mjs",
    "check": "node ferramentas/scripts/gerar-bundle-componentes.mjs --check && node ferramentas/testes/validar-estrutura.mjs && node ferramentas/testes/validar-dados-acessibilidade.mjs",
    "check:mobile": "node ferramentas/testes/validar-interacoes-mobile.mjs",
    "check:responsive": "node ferramentas/testes/validar-layouts-responsivos.mjs",
    "check:browser": "node ferramentas/testes/validar-navegador.mjs",
    "check:artifact": "node ferramentas/testes/validar-artefato.mjs",
    "check:published": "node ferramentas/testes/validar-artefato.mjs --final",
    "build": "node ferramentas/scripts/preparar-publicacao.mjs",
    "dev": "node ferramentas/scripts/servidor-local.mjs"
  },
  "engines": {
    "node": ">=22 <26"
  }
}
